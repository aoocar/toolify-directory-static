---
import "@/styles/global.css";
import "@/styles/guides.css";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

type Props = {
  lang: Lang;
  title: string;
  description: string;
};

const { lang, title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogLocale = lang === "zh" ? "zh_CN" : "en_US";
// hreflang alternates: swap the leading /zh|/en segment. Skip the /exit interstitial.
const showHreflang = !canonicalURL.pathname.includes("/exit");
const altFor = (l: Lang) => {
  const parts = canonicalURL.pathname.split("/");
  parts[1] = l;
  return new URL(parts.join("/") || "/", canonicalURL.origin).href;
};
const hrefZh = altFor("zh");
const hrefEn = altFor("en");
const ogImage = new URL("/og-default.png", Astro.site ?? Astro.url).href;
const siteName = t(lang, "brand");
const navItems = [
  { href: localizedPath(lang, "/accounts"), label: t(lang, "navAccounts") },
  { href: localizedPath(lang, "/platforms"), label: t(lang, "navPlatforms") },
  { href: localizedPath(lang, "/categories"), label: t(lang, "navCategories") },
  { href: localizedPath(lang, "/guides"), label: t(lang, "navGuides") },
  { href: localizedPath(lang, "/rankings"), label: t(lang, "navRankings") },
  { href: localizedPath(lang, "/new"), label: t(lang, "navNew") },
  { href: localizedPath(lang, "/services"), label: t(lang, "navServices") },
  { href: localizedPath(lang, "/submit"), label: t(lang, "navSubmit") },
  { href: "https://d.limingdao.com/", label: t(lang, "navTransfer"), external: true },
  { href: "https://cms.limingdao.com/", label: t(lang, "navDirectory"), external: true }
];

const currentPath = Astro.url.pathname.replace(/^\/(en|zh)/, "") || "/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {showHreflang && <link rel="alternate" hreflang="zh" href={hrefZh} />}
    {showHreflang && <link rel="alternate" hreflang="en" href={hrefEn} />}
    {showHreflang && <link rel="alternate" hreflang="x-default" href={hrefZh} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${t(lang, "slogan")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WJ8ZP9FSE9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WJ8ZP9FSE9');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "kn4x488ytp");
    </script>

    <!-- Google AdSense 验证（接入后可在 AdSense 后台开启 Auto ads 自动投放；ca-pub-8752263153695128 为用户旧账号） -->
    <meta name="google-adsense-account" content="ca-pub-8752263153695128" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8752263153695128" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="sponsor-strip">
      <div class="container sponsor-strip-inner">
        <span>🔥 {t(lang, "slogan")}</span>
        <a href={localizedPath(lang, "/services")} class="banner-cta-link">
          {lang === "zh" ? "了解 AI 代运营服务 →" : "Learn AI Management Services →"}
        </a>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={localizedPath(lang, "/")} aria-label={t(lang, "brand")}>
          <span class="brand-mark">🌅</span>
          <span>{t(lang, "brand")}</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {navItems.map((item) => (
            <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
              {item.label}
            </a>
          ))}
          <span class="lang-switch" aria-label="Language">
            {
              languages.map((item) => (
                <a href={localizedPath(item, currentPath)} aria-current={item === lang ? "true" : "false"}>
                  {item.toUpperCase()}
                </a>
              ))
            }
          </span>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <strong>🌅 {t(lang, "brand")}</strong>
          <p>{t(lang, "footerTagline")}</p>
        </div>
        <div class="footer-links">
          <a href={localizedPath(lang, "/services")}>{t(lang, "navServices")}</a>
          <a href={localizedPath(lang, "/submit")}>{t(lang, "navSubmit")}</a>
          <a href={localizedPath(lang, "/contact")}>{t(lang, "contactTitle")}</a>
          <a href={localizedPath(lang, "/privacy")}>{t(lang, "footerPrivacy")}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
