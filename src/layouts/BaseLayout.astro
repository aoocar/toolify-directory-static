---
import "@/styles/global.css";
import "@/styles/guides.css";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
};

const { lang, title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogLocale = lang === "zh" ? "zh_CN" : "en_US";
// hreflang alternates: swap the leading /zh|/en segment. Skip the /exit interstitial.
const showHreflang = !canonicalURL.pathname.includes("/exit");
const altFor = (l: Lang) => {
  const parts = canonicalURL.pathname.split("/");
  parts[1] = l;
  return new URL(parts.join("/") || "/", canonicalURL.origin).href;
};
const hrefZh = altFor("zh");
const hrefEn = altFor("en");
const ogImage = new URL("/og-default.png", Astro.site ?? Astro.url).href;
const siteName = t(lang, "brand");
const navItems = [
  { href: localizedPath(lang, "/accounts"), label: t(lang, "navAccounts") },
  { href: localizedPath(lang, "/tools"), label: t(lang, "navTools") },
  { href: localizedPath(lang, "/platforms"), label: t(lang, "navPlatforms") },
  { href: localizedPath(lang, "/categories"), label: t(lang, "navCategories") },
  { href: localizedPath(lang, "/guides"), label: t(lang, "navGuides") },
  { href: localizedPath(lang, "/rankings"), label: t(lang, "navRankings") },
  { href: localizedPath(lang, "/new"), label: t(lang, "navNew") },
  { href: localizedPath(lang, "/services"), label: t(lang, "navServices") },
  { href: localizedPath(lang, "/submit"), label: t(lang, "navSubmit") },
  { href: "https://d.limingdao.com/", label: t(lang, "navTransfer"), external: true },
  { href: "https://cms.limingdao.com/", label: t(lang, "navDirectory"), external: true }
];

const currentPath = Astro.url.pathname.replace(/^\/(en|zh)/, "") || "/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL.href} />
    <!-- ---- Resource hints: warm up third-party connections ---- -->
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="//pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <!-- clarity.ms / www.clarity.ms 指向同一域，仅预热一个，避免占用宝贵的 preconnect 预算（浏览器约 6 个并发限制） -->
    <link rel="dns-prefetch" href="//www.clarity.ms" />
    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
    {showHreflang && <link rel="alternate" hreflang="zh" href={hrefZh} />}
    {showHreflang && <link rel="alternate" hreflang="en" href={hrefEn} />}
    {showHreflang && <link rel="alternate" hreflang="x-default" href={hrefZh} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${t(lang, "slogan")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -- loaded lazily via the third-party loader below; stub + pageview config stay inline so tracking still works -->
    <script is:inline>
      // ---- Deferred third-party loader (analytics + ads) ----
      // None of these are on the LCP critical path. Loading them all eagerly in
      // <head> blocks the main thread (TBT) and hurts LCP, especially on mobile.
      // We queue them and inject lazily once the page is idle (or on first user
      // interaction as a fallback), so the initial render stays fast.
      // Tiny stubs below let any callers that fire before the real scripts
      // arrive still work (dataLayer / gtag / clarity).
      (function () {
        // ---- Stubs ----
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };

        var d = document;
        var started = false;

        // 按优先级逐个注入，避免同一时刻爆发多个第三方网络请求 + 主线程解析，
        // 进一步压低 LCP/TBT。优先级：GA（数据最要紧）→ Clarity（体验分析）→ AdSense（广告，最不关键，最后才加载）。
        var queue = [
          // 1) Google tag (gtag.js)
          function () {
            var s = d.createElement("script");
            s.async = true;
            s.src = "https://www.googletagmanager.com/gtag/js?id=G-WJ8ZP9FSE9";
            d.head.appendChild(s);
          },
          // 2) Microsoft Clarity
          function () {
            var s = d.createElement("script");
            s.async = true;
            s.src = "https://www.clarity.ms/tag/kn4x488ytp";
            d.head.appendChild(s);
          },
          // 3) Google AdSense — 最后加载（广告不阻塞数据/体验采集）
          function () {
            var s = d.createElement("script");
            s.async = true;
            s.crossOrigin = "anonymous";
            s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8752263153695128";
            d.head.appendChild(s);
          }
        ];

        function loadNext() {
          if (started && queue.length) {
            queue.shift()();
          }
        }

        // 每个空闲片段只加载一个脚本，错峰执行，减少瞬时主线程占用。
        function pump() {
          if (started) return;
          started = true;
          if ("requestIdleCallback" in window) {
            // 首帧空闲先拉 GA，随后在更晚的空闲片段逐个补上 Clarity / AdSense。
            var delays = [3500, 6000, 9000];
            delays.forEach(function (t) {
              window.requestIdleCallback(loadNext, { timeout: t });
            });
          } else {
            // 不支持 requestIdleCallback：退化到 load 后逐个错峰。
            (function step() {
              if (queue.length) queue.shift()();
              if (queue.length) setTimeout(step, 800);
            })();
          }
        }

        // 兜底：首次用户交互就尽快把 GA/Clarity 拉起来（AdSense 仍可最后）。
        var gestureFired = false;
        function onUserGesture() {
          if (gestureFired) return;
          gestureFired = true;
          started = true;
          loadNext();
          // 交互后再错峰拉起剩下两个
          setTimeout(function () { if (queue.length) queue.shift()(); }, 500);
          setTimeout(function () { if (queue.length) queue.shift()(); }, 1500);
        }
        ["scroll", "mousedown", "touchstart", "keydown"].forEach(function (ev) {
          window.addEventListener(ev, onUserGesture, { passive: true, once: true });
        });

        // 优先在空闲时加载；空闲回调不可用时退化为 load 事件后错峰加载。
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(pump, { timeout: 2500 });
        } else {
          window.addEventListener("load", pump);
        }
      })();
    </script>

    <!-- ---- gtag pageview config ----
         Fires as soon as gtag.js is ready. The stub above already pushed the
         pageview onto dataLayer, and gtag.js replays queued commands on load.
         We keep UTM first-hit attribution via sessionStorage for cross-tool
         reporting. -->
    <script is:inline>
      (function () {
        function gtagConfig() {
          try {
            var params = new URLSearchParams(window.location.search);
            var urlParams = {};
            ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {
              var v = params.get(k);
              if (v) urlParams[k] = v;
            });
            var sessionUtm = sessionStorage.getItem('lmdao_utm');
            var firstHit = sessionUtm ? JSON.parse(sessionUtm) : urlParams;
            if (Object.keys(firstHit).length && !sessionUtm) {
              try { sessionStorage.setItem('lmdao_utm', JSON.stringify(firstHit)); } catch (e) {}
            }
            var cfg = { page_path: window.location.pathname };
            if (Object.keys(firstHit).length) Object.assign(cfg, firstHit);
            window.gtag('config', 'G-WJ8ZP9FSE9', cfg);
          } catch (e) {
            window.gtag('config', 'G-WJ8ZP9FSE9');
          }
        }
        gtagConfig();
      })();
    </script>

    <!-- Google AdSense verification (enable Auto ads in the AdSense dashboard after approval; ca-pub-8752263153695128 is the user's legacy account) -->
    <meta name="google-adsense-account" content="ca-pub-8752263153695128" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(lang, "skipToContent")}</a>
    <div class="sponsor-strip">
      <div class="container sponsor-strip-inner">
        <span>🔥 {t(lang, "slogan")}</span>
        <a href={localizedPath(lang, "/services")} class="banner-cta-link" data-ga-event="business_cta_click" data-ga-category="conversion" data-ga-label="banner">
          {lang === "zh" ? "了解 AI 代运营服务 →" : "Learn AI Management Services →"}
        </a>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={localizedPath(lang, "/")} aria-label={t(lang, "brand")}>
          <span class="brand-mark">🌅</span>
          <span>{t(lang, "brand")}</span>
        </a>
        <nav class="nav-links" aria-label={t(lang, "ariaNavPrimary")}>
          {navItems.map((item) => (
            <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
              {item.label}
            </a>
          ))}
          <span class="lang-switch" aria-label={t(lang, "ariaLanguage")}>
            {
              languages.map((item) => (
                <a href={localizedPath(item, currentPath)} {...(item === lang ? { "aria-current": "page" } : {})}>
                  {item.toUpperCase()}
                </a>
              ))
            }
          </span>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <strong>🌅 {t(lang, "brand")}</strong>
          <p>{t(lang, "footerTagline")}</p>
        </div>
        <div class="footer-links">
          <a href={localizedPath(lang, "/services")}>{t(lang, "navServices")}</a>
          <a href={localizedPath(lang, "/submit")}>{t(lang, "navSubmit")}</a>
          <a href={localizedPath(lang, "/contact")}>{t(lang, "contactTitle")}</a>
          <a href={localizedPath(lang, "/privacy")}>{t(lang, "footerPrivacy")}</a>
        </div>
      </div>
    </footer>
    <!-- GA4 conversion events: delegated click tracking.
         Links opt in via data-ga-event (+ optional data-ga-* attrs).
         b/contact links carry UTM-ish params for cross-tool attribution. -->
    <script is:inline>
      (function () {
        function ga(name, params) {
          try { if (window.gtag) window.gtag('event', name, params || {}); } catch (e) {}
        }
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('[data-ga-event]') : null;
          if (!el) return;
          var name = el.getAttribute('data-ga-event');
          if (!name) return;
          var params = { event_category: el.getAttribute('data-ga-category') || 'engagement' };
          ['label','value'].forEach(function (k) {
            var v = el.getAttribute('data-ga-' + k);
            if (v) params[k] = v;
          });
          ga(name, params);
        });
      })();
    </script>
  </body>
</html>
