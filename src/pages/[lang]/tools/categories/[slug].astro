---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getToolCategoryCounts, getToolsByCategory } from "@/lib/directory";
import { breadcrumbJsonLd, collectionPageJsonLd } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export async function getStaticPaths() {
  const counts = await getToolCategoryCounts();
  const paths = [];
  for (const lang of languages) {
    for (const { category } of counts) {
      paths.push({ params: { lang, slug: category } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const category = slug || "未分类";
const tools = await getToolsByCategory(category);

const metaDescription =
  lang === "zh"
    ? `${category}分类精选 AI 工具推荐 - ${tools.length} 个优质工具，来自黎明岛 AI 工具导航。`
    : `Curated ${category} AI tools - ${tools.length} quality picks from Dawn Island AI Tool Navigator.`;
const pageTitle =
  lang === "zh"
    ? `${category} AI 工具推荐 - ${tools.length} 个精选 | 黎明岛`
    : `${category} AI Tools - ${tools.length} Curated | Dawn Island`;

const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(localizedPath(lang, `/tools/categories/${encodeURIComponent(category)}`), siteBase).href;
const collectionLd = collectionPageJsonLd({
  name: pageTitle,
  description: metaDescription,
  url: pageUrl,
  lang,
  items: tools.slice(0, 100).map((tool) => ({
    name: tool.title,
    url: new URL(localizedPath(lang, `/tools/${tool.slug}`), siteBase).href
  }))
});
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: lang === "zh" ? "AI 工具导航" : "AI Tool Navigator", url: new URL(localizedPath(lang, "/tools"), siteBase).href },
    { name: category, url: pageUrl }
  ]
});
---

<BaseLayout lang={lang} title={pageTitle} description={metaDescription}>
  <JsonLd data={collectionLd} />
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{category}</h1>
        <p class="lead">
          {
            lang === "zh"
              ? `「${category}」分类收录 ${tools.length} 个精选 AI 工具，持续维护更新。`
              : `${tools.length} curated tools in the ${category} category, continuously maintained.`
          }
        </p>
      </div>

      <div class="tool-list">
        {
          tools.map((tool) => (
            <article class="tool-row">
              <div class="tool-info">
                <h3><a href={localizedPath(lang, `/tools/${tool.slug}`)}>{tool.title}</a></h3>
                {tool.description && <p>{tool.description.slice(0, 140)}{tool.description.length > 140 ? "…" : ""}</p>}
              </div>
              {
                tool.url && (
                  <a class="button secondary" href={localizedPath(lang, `/exit?to=${encodeURIComponent(tool.url)}`)} target="_blank" rel="noopener noreferrer" data-ga-event="exit_click" data-ga-label={`tool:${tool.slug}`}>
                    {lang === "zh" ? "访问" : "Visit"}
                  </a>
                )
              }
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tool-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.75rem;
    background: var(--card-bg, #fff);
  }
  .tool-info h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }
  .tool-info p {
    margin: 0 0 0.35rem;
    color: var(--muted, #64748b);
    font-size: 0.88rem;
  }
</style>
