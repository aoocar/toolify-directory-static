---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getTools, getToolBySlug } from "@/lib/directory";
import { breadcrumbJsonLd, softwareAppJsonLd } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export async function getStaticPaths() {
  const tools = await getTools();
  const paths = [];
  for (const lang of languages) {
    for (const tool of tools) {
      paths.push({ params: { lang, slug: tool.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const tool = await getToolBySlug(slug);

if (!tool) {
  return Astro.redirect(localizedPath(lang, "/404"));
}

const metaDescription =
  (tool.description || `${tool.title} 工具介绍`) + (lang === "zh" ? " - 黎明岛 AI 工具导航" : " - Dawn Island AI Tool Navigator");
const pageTitle =
  lang === "zh"
    ? `${tool.title} - AI 工具介绍 | 黎明岛`
    : `${tool.title} - AI Tool | Dawn Island`;

const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(localizedPath(lang, `/tools/${tool.slug}`), siteBase).href;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: lang === "zh" ? "AI 工具导航" : "AI Tool Navigator", url: new URL(localizedPath(lang, "/tools"), siteBase).href },
    { name: tool.title, url: pageUrl }
  ]
});
const appLd = softwareAppJsonLd({
  name: tool.title,
  description: tool.description || tool.title,
  url: pageUrl,
  brand: t(lang, "brand"),
  lang,
  appUrl: tool.url
});
---

<BaseLayout lang={lang} title={pageTitle} description={metaDescription}>
  <JsonLd data={appLd} />
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <article class="tool-detail">
        <div class="section-head">
          <h1>{tool.title}</h1>
          {tool.category && <span class="pill">{tool.category}</span>}
          {tool.subCategory && <span class="pill">{tool.subCategory}</span>}
        </div>

        {
          tool.description && (
            <p class="lead">{tool.description}</p>
          )
        }

        <div class="detail-section">
          <h2>{lang === "zh" ? "快速访问" : "Quick Access"}</h2>
          {
            tool.url ? (
              <a class="button primary" href={localizedPath(lang, `/exit?to=${encodeURIComponent(tool.url)}`)} target="_blank" rel="noopener noreferrer" data-ga-event="exit_click" data-ga-label={`tool:${tool.slug}`}>
                {lang === "zh" ? `访问 ${tool.title} →` : `Visit ${tool.title} →`}
              </a>
            ) : (
              <p class="empty-state">{lang === "zh" ? "该工具暂无直达链接，可在站内搜索相关信息。" : "No direct link available yet — search within the site for more info."}</p>
            )
          }
        </div>

        {
          tool.tags && tool.tags.length > 0 && (
            <div class="detail-section">
              <h2>{t(lang, "tags")}</h2>
              <div class="tag-row">
                {tool.tags.map((tag) => <span class="pill">#{tag}</span>)}
              </div>
            </div>
          )
        }

        <div class="detail-section">
          <h2>{lang === "zh" ? "相关工具" : "Related Tools"}</h2>
          {
            tool.category && (
              <a class="button secondary" href={localizedPath(lang, `/tools/categories/${encodeURIComponent(tool.category)}`)}>
                {lang === "zh" ? `浏览「${tool.category}」分类全部工具 →` : `Browse all tools in ${tool.category} →`}
              </a>
            )
          }
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
