---
import AccountCard from "@/components/AccountCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getLatestAccounts } from "@/lib/directory";
import { breadcrumbJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const latestAccounts = await getLatestAccounts();

// BreadcrumbList: Home > New additions.
const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteBase).href;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: t(lang, "navNew"), url: pageUrl }
  ] satisfies Crumb[]
});
---

<BaseLayout lang={lang} title={`${t(lang, "navNew")} - ${t(lang, "brand")}`} description={t(lang, "heroSubtitle")}>
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{t(lang, "navNew")}</h1>
      </div>
      <div class="grid">
        {latestAccounts.map((account) => <AccountCard account={account} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
