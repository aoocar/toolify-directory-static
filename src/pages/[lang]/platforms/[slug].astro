---
import AccountCard from "@/components/AccountCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getAccountsByPlatform, getPlatformBySlug, getPlatforms } from "@/lib/directory";
import { breadcrumbJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export async function getStaticPaths() {
  const platforms = await getPlatforms();
  const paths = [];

  for (const lang of languages) {
    for (const plat of platforms) {
      paths.push({ params: { lang, slug: plat.slug } });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const platform = await getPlatformBySlug(slug);

if (!platform) {
  return Astro.redirect(localizedPath(lang, "/404"));
}

const platformAccounts = await getAccountsByPlatform(slug);

// BreadcrumbList: Home > Browse by Platform > platform name.
const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteBase).href;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: t(lang, "platformNav"), url: new URL(localizedPath(lang, "/platforms"), siteBase).href },
    { name: `${platform.icon} ${platform.name[lang]}`, url: pageUrl }
  ] satisfies Crumb[]
});
---

<BaseLayout lang={lang} title={`${platform.name[lang]} - ${t(lang, "brand")}`} description={platform.description[lang]}>
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{platform.icon} {platform.name[lang]}</h1>
        <p class="lead">{platform.description[lang]}</p>
      </div>

      {
        platformAccounts.length > 0 ? (
          <div class="grid">
            {platformAccounts.map((account) => <AccountCard account={account} lang={lang} />)}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t(lang, "empty")}</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
