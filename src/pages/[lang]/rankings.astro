---
import AccountCard from "@/components/AccountCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getRankedAccounts } from "@/lib/directory";
import { breadcrumbJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const url = Astro.url;
const tab = url.searchParams.get("tab") || "followers";

let activeTab: "followers" | "engagement" | "growth" = "followers";
if (tab === "engagement" || tab === "growth") {
  activeTab = tab;
}

const rankedAccounts = await getRankedAccounts(activeTab);

// BreadcrumbList: Home > Rankings (pathname only — drop any ?tab= filter).
const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteBase).href;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: t(lang, "navRankings"), url: pageUrl }
  ] satisfies Crumb[]
});
---

<BaseLayout lang={lang} title={`${t(lang, "navRankings")} - ${t(lang, "brand")}`} description={t(lang, "heroSubtitle")}>
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{t(lang, "navRankings")}</h1>
        <div class="tab-row">
          <a
            class={`tab-button ${activeTab === "followers" ? "active" : ""}`}
            href={`${localizedPath(lang, "/rankings")}?tab=followers`}
            {...(activeTab === "followers" ? { "aria-current": "page" } : {})}
          >
            {t(lang, "rankByFollowers")}
          </a>
          <a
            class={`tab-button ${activeTab === "engagement" ? "active" : ""}`}
            href={`${localizedPath(lang, "/rankings")}?tab=engagement`}
            {...(activeTab === "engagement" ? { "aria-current": "page" } : {})}
          >
            {t(lang, "rankByEngagement")}
          </a>
          <a
            class={`tab-button ${activeTab === "growth" ? "active" : ""}`}
            href={`${localizedPath(lang, "/rankings")}?tab=growth`}
            {...(activeTab === "growth" ? { "aria-current": "page" } : {})}
          >
            {t(lang, "rankByGrowth")}
          </a>
        </div>
      </div>

      <div class="grid">
        {rankedAccounts.map((account) => <AccountCard account={account} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
