---
import AccountCard from "@/components/AccountCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getAccounts } from "@/lib/directory";
import { breadcrumbJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const allAccounts = await getAccounts();

// BreadcrumbList: Home > All creators (pathname only — drop any ?q= filter).
const siteBase = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteBase).href;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: t(lang, "allAccounts"), url: pageUrl }
  ] satisfies Crumb[]
});
---

<BaseLayout lang={lang} title={`${t(lang, "allAccounts")} - ${t(lang, "brand")}`} description={t(lang, "heroSubtitle")}>
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{t(lang, "allAccounts")}</h1>
        <form class="search-panel inline-search" action={localizedPath(lang, "/accounts")} method="get" role="search">
          <input name="q" type="search" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
          <button class="button" type="submit">{t(lang, "search")}</button>
        </form>
      </div>

      <p class="search-results-info" data-search-info aria-live="polite"></p>

      <div class="grid">
        {allAccounts.map((account) => (
          <AccountCard
            account={account}
            lang={lang}
            searchText={[account.name[lang], account.tagline[lang], account.description[lang], ...account.tags].join(" ").toLowerCase()}
          />
        ))}
      </div>

      <div class="empty-state" data-search-empty hidden>
        <p>{t(lang, "empty")}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive-enhancement client-side filter for the static accounts list.
  // No backend/DB: the full list is in the HTML; JS only toggles visibility.
  const form = document.querySelector<HTMLFormElement>(".inline-search");
  const input = document.querySelector<HTMLInputElement>('.inline-search input[name="q"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".account-card[data-search]"));
  const info = document.querySelector<HTMLElement>("[data-search-info]");
  const emptyState = document.querySelector<HTMLElement>("[data-search-empty]");
  const grid = document.querySelector<HTMLElement>(".grid");
  const pageLang = document.documentElement.lang || "zh";

  function applyFilter(raw: string) {
    const q = raw.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const hay = (card.dataset.search || "").toLowerCase();
      const match = q === "" || hay.includes(q);
      card.style.display = match ? "" : "none";
      if (match) visible++;
    }
    if (info) {
      info.textContent = q === ""
        ? ""
        : (pageLang === "zh" ? `找到 ${visible} 个相关账号` : `Found ${visible} creators`);
    }
    const anyVisible = visible > 0;
    if (emptyState) emptyState.hidden = anyVisible;
    if (grid) grid.style.display = anyVisible ? "" : "none";
  }

  if (input) {
    const params = new URLSearchParams(window.location.search);
    const initial = params.get("q") || "";
    if (initial) {
      input.value = initial;
      applyFilter(initial);
    }
    input.addEventListener("input", () => applyFilter(input.value));
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        applyFilter(input.value);
        const url = new URL(window.location.href);
        if (input.value) url.searchParams.set("q", input.value);
        else url.searchParams.delete("q");
        window.history.replaceState({}, "", url);
      });
    }
  }
</script>
