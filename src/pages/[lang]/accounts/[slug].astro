---
import { getCollection } from "astro:content";
import { unified } from "unified";
import remarkParse from "remark-parse";
import remarkRehype from "remark-rehype";
import rehypeStringify from "rehype-stringify";
import BusinessCTA from "@/components/BusinessCTA.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { formatNumber, getAccountBySlug, getAccounts, getCategories, getGuidesMentioningAccount } from "@/lib/directory";
import { breadcrumbJsonLd, faqJsonLd, personJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export async function getStaticPaths() {
  const allAccounts = await getAccounts();
  const paths = [];

  for (const lang of languages) {
    for (const account of allAccounts) {
      paths.push({
        params: { lang, slug: account.slug }
      });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const account = await getAccountBySlug(slug);

if (!account) {
  return Astro.redirect("/404");
}

// Render the account's bilingual Markdown body (populated by vault sync after de-thinning).
// The body uses `<!-- zh -->` / `<!-- en -->` markers; we extract only the active language
// segment (at the raw-markdown level) so the English page never shows Chinese (and vice versa),
// then render that segment with the same remark/rehype pipeline Astro ships (already in node_modules).
function extractLangMarkdown(md: string, activeLang: Lang): string {
  const zhMarker = "<!-- zh -->";
  const enMarker = "<!-- en -->";
  const hasZh = md.includes(zhMarker);
  const hasEn = md.includes(enMarker);
  if (!hasZh && !hasEn) return md.trim(); // legacy single-language body
  if (activeLang === "zh") {
    const start = hasZh ? md.indexOf(zhMarker) + zhMarker.length : 0;
    const end = hasEn ? md.indexOf(enMarker) : md.length;
    return md.slice(start, end).trim();
  }
  if (!hasEn) return ""; // no English segment → English page shows no body
  const start = md.indexOf(enMarker) + enMarker.length;
  return md.slice(start).trim();
}

// Safe-filter (v1): on English pages, only keep ASCII/English tags & content
// style so the page carries zero Chinese in these data fields. No translation
// needed — Chinese-only values are simply omitted (en pages lose a few tags).
const isAscii = (s: string) => /^[\u0000-\u007f]*$/.test(s);
const displayTags = lang === "en" ? account.tags.filter(isAscii) : account.tags;
const displayStyle = lang === "en" ? account.contentStyle.filter(isAscii) : account.contentStyle;

let bodyHtml: string | null = null;
const accountEntry = (await getCollection("accounts")).find(
  (e) => (e.data.slug ?? e.slug) === slug
);
if (accountEntry?.body?.trim()) {
  const langMd = extractLangMarkdown(accountEntry.body, lang);
  if (langMd) {
    const processed = await unified()
      .use(remarkParse)
      .use(remarkRehype)
      .use(rehypeStringify)
      .process(langMd);
    bodyHtml = String(processed);
  }
}

const frequencyMap: Record<string, Record<Lang, string>> = {
  daily: { zh: "每日更新", en: "Daily" },
  weekly: { zh: "每周更新", en: "Weekly" },
  biweekly: { zh: "每两周更新", en: "Biweekly" },
};

const monetizationMap: Record<string, Record<Lang, string>> = {
  "e-commerce": { zh: "电商带货", en: "E-commerce" },
  "brand-deals": { zh: "品牌合作", en: "Brand deals" },
  courses: { zh: "知识付费", en: "Courses" },
  mixed: { zh: "多元变现", en: "Mixed" },
};

const geoSummary = lang === "zh" ? account.geo?.answer_summary_zh : account.geo?.answer_summary_en;
const geoFacts =
  (lang === "zh" ? (account.geo?.facts_zh ?? account.geo?.facts) : account.geo?.facts_en) ?? [];
const geoFaq =
  (lang === "zh" ? (account.geo?.faq_zh ?? account.geo?.faq) : account.geo?.faq_en) ?? [];
const faqLd = faqJsonLd(geoFaq, lang);
const metaDescription = (lang === "zh" ? account.seo?.meta_description_zh : account.seo?.meta_description_en) || account.tagline[lang];

// Reverse cross-link: guides that name this account.
const guidesForAccount = await getGuidesMentioningAccount(slug, lang);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Topical authority for the Person graph: the account's niches (category
// names) + tags, deduped. jobTitle is a truthful generic — every entry in the
// directory is a content creator, so we avoid fabricating per-person titles.
const allCategories = await getCategories();
const catName = (slug: string) =>
  allCategories.find((c) => c.slug === slug)?.name[lang] || "";
const knowsAbout = Array.from(
  new Set([...account.categories.map(catName).filter(Boolean), ...(lang === "en" ? account.tags.filter(isAscii) : account.tags)])
);
const jobTitle = lang === "zh" ? "内容创作者" : "Content Creator";

// Page <title>: editorial overrides (seo.title_*) win; otherwise build a
// domain-ized default that injects the primary niche for relevance/CTR.
// e.g. zh: "3Blue1Brown - 数学教育创作者 | 黎明岛"
//      en: "3Blue1Brown - Mathematics Creator | Dawn Island"
const primaryCatSlug = account.categories[0];
const primaryCatName = primaryCatSlug ? catName(primaryCatSlug) : "";
const defaultTitle = primaryCatName
  ? (lang === "zh"
      ? `${account.name[lang]} - ${primaryCatName}创作者 | ${t(lang, "brand")}`
      : `${account.name[lang]} - ${primaryCatName} Creator | ${t(lang, "brand")}`)
  : `${account.name[lang]} - ${t(lang, "brand")}`;
const pageTitle =
  (lang === "zh" ? account.seo?.title_zh : account.seo?.title_en) || defaultTitle;

const personLd = personJsonLd({
  name: account.name[lang],
  description: metaDescription,
  url: pageUrl,
  brand: t(lang, "brand"),
  profileUrl: account.profileUrl,
  knowsAbout,
  jobTitle
});

// BreadcrumbList: Home > Content Niches > [primary category] > account name.
const siteBase = Astro.site ?? Astro.url;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: ((): Crumb[] => {
    const crumbs: Crumb[] = [
      { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
      { name: t(lang, "categories"), url: new URL(localizedPath(lang, "/categories"), siteBase).href }
    ];
    const primaryCat = account.categories[0];
    const cn = primaryCat ? catName(primaryCat) : "";
    if (cn) {
      crumbs.push({
        name: cn,
        url: new URL(localizedPath(lang, `/categories/${primaryCat}`), siteBase).href
      });
    }
    crumbs.push({ name: account.name[lang], url: pageUrl });
    return crumbs;
  })()
});
---

<BaseLayout lang={lang} title={pageTitle} description={metaDescription}>
  <JsonLd data={faqLd} />
  <JsonLd data={personLd} />
  <JsonLd data={breadcrumbLd} />
  <article class="detail-page section">
    <div class="container detail-grid">
      <div class="detail-main">
        <header class="detail-header">
          <span class="detail-logo">{account.avatar}</span>
          <div>
            <h1>
              {account.name[lang]}
              {account.verified && <span class="verified-badge" title={t(lang, "verified")}>✓</span>}
            </h1>
            <p class="lead">{account.tagline[lang]}</p>
          </div>
        </header>

        <section class="detail-section">
          <h2>{lang === "zh" ? "账号简介" : "About"}</h2>
          <p>{account.description[lang]}</p>
        </section>

        {
          bodyHtml && (
            <section class="detail-section">
              <h2>{lang === "zh" ? "详细档案" : "Full profile"}</h2>
              <div class="account-body" set:html={bodyHtml} />
            </section>
          )
        }

        {displayStyle.length > 0 && (
          <section class="detail-section">
            <h2>{t(lang, "contentStyle")}</h2>
            <div class="tag-row">
              {displayStyle.map((style) => <span class="pill">#{style}</span>)}
            </div>
          </section>
        )}

        {displayTags.length > 0 && (
          <section class="detail-section">
            <h2>{t(lang, "tags")}</h2>
            <div class="tag-row">
              {displayTags.map((tag) => <span class="pill">#{tag}</span>)}
            </div>
          </section>
        )}

        {
          geoSummary && (
            <section class="detail-section">
              <h2>{lang === "zh" ? "一句话速览" : "At a glance"}</h2>
              <p>{geoSummary}</p>
            </section>
          )
        }

        {
          geoFacts.length > 0 && (
            <section class="detail-section">
              <h2>{lang === "zh" ? "关键事实" : "Key facts"}</h2>
              <dl class="fact-list">
                {geoFacts.map((fact) =>
                  Object.entries(fact).map(([key, value]) => (
                    <div class="fact-item">
                      <dt>{key}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))
                )}
              </dl>
            </section>
          )
        }

        {
          geoFaq.length > 0 && (
            <section class="detail-section">
              <h2>FAQ</h2>
              <dl class="faq-list">
                {geoFaq.map((item) =>
                  Object.entries(item).map(([question, answer]) => (
                    <div class="faq-item">
                      <dt>{question}</dt>
                      <dd>{answer}</dd>
                    </div>
                  ))
                )}
              </dl>
            </section>
          )
        }

        {
          guidesForAccount.length > 0 && (
            <section class="detail-section">
              <h2>{t(lang, "guidesForAccount")}</h2>
              <ol class="link-list">
                {guidesForAccount.map((item) => (
                  <li>
                    <a href={localizedPath(lang, `/guides/${item.slug}`)}>{item.title[lang]}</a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section class="detail-section highlight-cta-section">
          <BusinessCTA lang={lang} type="detail" />
        </section>
      </div>

      <aside class="detail-sidebar">
        <div class="sidebar-panel">
          <h2>{lang === "zh" ? "账号数据与特征" : "Account Stats"}</h2>
          <table class="stats-table">
            <tbody>
              <tr>
                <td><strong>{t(lang, "followers")}</strong></td>
                <td>{formatNumber(account.followerCount, lang)}</td>
              </tr>
              <tr>
                <td><strong>{t(lang, "engagement")}</strong></td>
                <td>{formatNumber(account.avgEngagement, lang)}</td>
              </tr>
              <tr>
                <td><strong>{t(lang, "growth")}</strong></td>
                <td>{account.growthRate !== undefined ? `+${account.growthRate}%` : "—"}</td>
              </tr>
              <tr>
                <td><strong>{t(lang, "frequency")}</strong></td>
                <td>{frequencyMap[account.contentFrequency]?.[lang] || account.contentFrequency || "—"}</td>
              </tr>
              <tr>
                <td><strong>{t(lang, "monetization")}</strong></td>
                <td><span class="pill select">{monetizationMap[account.monetization]?.[lang] || account.monetization}</span></td>
              </tr>
            </tbody>
          </table>
          <a class="button primary full-width text-center" href={`/${lang}/exit?to=${encodeURIComponent(account.profileUrl)}`} rel="noopener">
            {t(lang, "visitProfile")}
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
