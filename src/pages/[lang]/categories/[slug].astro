---
import AccountCard from "@/components/AccountCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { getAccountsByCategory, getCategories, getCategoryBySlug, getRelatedGuides } from "@/lib/directory";
import { breadcrumbJsonLd, faqJsonLd, collectionPageJsonLd, type Crumb } from "@/lib/jsonld";
import { languages, localizedPath, t, type Lang } from "@/lib/i18n";

export async function getStaticPaths() {
  const categories = await getCategories();
  const paths = [];

  for (const lang of languages) {
    for (const cat of categories) {
      paths.push({ params: { lang, slug: cat.slug } });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const category = await getCategoryBySlug(slug);

if (!category) {
  return Astro.redirect(localizedPath(lang, "/404"));
}

const categoryAccounts = await getAccountsByCategory(slug);
// Cross-link: guides covering this niche.
const categoryGuides = await getRelatedGuides(lang, slug, "");

const geoSummary = lang === "zh" ? category.geo?.answer_summary_zh : category.geo?.answer_summary_en;
// Bilingual facts/faq: prefer the explicit _en / _zh variants, falling back to
// the legacy single-language `facts`/`faq` (Chinese) so the English page never
// renders Chinese (mirrors the account detail page logic).
const geoFacts =
  (lang === "zh" ? (category.geo?.facts_zh ?? category.geo?.facts) : category.geo?.facts_en) ?? [];
const geoFaq =
  (lang === "zh" ? (category.geo?.faq_zh ?? category.geo?.faq) : category.geo?.faq_en) ?? [];
const faqLd = faqJsonLd(geoFaq, lang);
const metaDescription = (lang === "zh" ? category.seo?.meta_description_zh : category.seo?.meta_description_en) || category.description[lang];
const pageTitle =
  (lang === "zh" ? category.seo?.title_zh : category.seo?.title_en) ||
  `${category.name[lang]} - ${t(lang, "brand")}`;

// CollectionPage structured data: the page is a curated list of creators.
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const collectionLd = collectionPageJsonLd({
  name: category.name[lang],
  description: metaDescription,
  url: pageUrl,
  lang,
  items: categoryAccounts.map((a) => ({
    name: a.name[lang],
    url: new URL(localizedPath(lang, `/accounts/${a.slug}`), Astro.site ?? Astro.url).href
  }))
});

// BreadcrumbList: Home > Content Niches > category name.
const siteBase = Astro.site ?? Astro.url;
const breadcrumbLd = breadcrumbJsonLd({
  lang,
  items: [
    { name: t(lang, "brand"), url: new URL(localizedPath(lang, "/"), siteBase).href },
    { name: t(lang, "categories"), url: new URL(localizedPath(lang, "/categories"), siteBase).href },
    { name: category.name[lang], url: pageUrl }
  ] satisfies Crumb[]
});
---

<BaseLayout lang={lang} title={pageTitle} description={metaDescription}>
  <JsonLd data={collectionLd} />
  <JsonLd data={faqLd} />
  <JsonLd data={breadcrumbLd} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{category.icon} {category.name[lang]}</h1>
        <p class="lead">{category.description[lang]}</p>
      </div>

      {
        geoSummary && (
          <section class="detail-section">
            <h2>{lang === "zh" ? "领域速览" : "At a glance"}</h2>
            <p>{geoSummary}</p>
          </section>
        )
      }

      {
        geoFacts.length > 0 && (
          <section class="detail-section">
            <h2>{lang === "zh" ? "关键事实" : "Key facts"}</h2>
            <dl class="fact-list">
              {geoFacts.map((fact) =>
                Object.entries(fact).map(([key, value]) => (
                  <div class="fact-item">
                    <dt>{key}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              )}
            </dl>
          </section>
        )
      }

      {
        geoFaq.length > 0 && (
          <section class="detail-section">
            <h2>FAQ</h2>
            <dl class="faq-list">
              {geoFaq.map((item) =>
                Object.entries(item).map(([question, answer]) => (
                  <div class="faq-item">
                    <dt>{question}</dt>
                    <dd>{answer}</dd>
                  </div>
                ))
              )}
            </dl>
          </section>
        )
      }

      {
        categoryAccounts.length > 0 ? (
          <div class="grid">
            {categoryAccounts.map((account) => <AccountCard account={account} lang={lang} />)}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t(lang, "empty")}</p>
          </div>
        )
      }

      {
        categoryGuides.length > 0 && (
          <section class="detail-section">
            <h2>{t(lang, "guidesInCategory")}</h2>
            <ol class="link-list">
              {categoryGuides.map((item) => (
                <li>
                  <a href={localizedPath(lang, `/guides/${item.slug}`)}>{item.title[lang]}</a>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>
