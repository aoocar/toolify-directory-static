---
import { defaultLang, localizedPath } from "@/lib/i18n";

const target = localizedPath(defaultLang, "/");
---

<!-- Root redirect page. In production Vercel 308-redirects "/" to "/zh" (see
     vercel.json), so this page is only a fallback for other hosting. We avoid the
     auto-refresh meta tag (an axe accessibility failure) and instead offer a
     visible link plus an unobtrusive JS redirect that keeps the link as a no-JS
     fallback. -->
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={target} />
    <title>黎明岛 · Dawn Island</title>
  </head>
  <body style="margin:0; font-family:system-ui,-apple-system,'Segoe UI',sans-serif;">
    <main style="min-height:100vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:24px;">
      <div>
        <p style="font-size:1.25rem; margin:0 0 16px;">黎明岛 · Dawn Island</p>
        <p style="margin:0 0 20px;">欢迎访问黎明岛，正在为你跳转到中文首页…</p>
        <a href={target} style="display:inline-block; padding:12px 24px; background:#6366f1; color:#fff; border-radius:8px; text-decoration:none; font-weight:600;">继续 / Continue</a>
      </div>
    </main>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
