---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout lang="zh" title="页面不存在 - 黎明岛" description="抱歉，您访问的页面不存在或已被移动。">
  <section class="section">
    <div class="container" style="text-align:center; padding: 4rem 1rem;">
      <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">404</h1>
      <p style="font-size: 1.25rem; margin-bottom: 1.5rem;">抱歉，您访问的页面不存在或已被移动。</p>
      <p style="margin-bottom: 2rem; color: var(--muted, #666);">The page you are looking for does not exist or has moved.</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a class="button primary" href="/zh">返回首页（中文）</a>
        <a class="button" href="/en">Home (English)</a>
      </div>
    </div>
  </section>
</BaseLayout>
